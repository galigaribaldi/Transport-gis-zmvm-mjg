      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='11335' id='5' type-v2='text' w='98574' x='713' y='1008'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='13'>Dashboard Comparativo KPI: Red Actual - Propuesta Anillo MB y Propuesta Anillo Metro</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='7'>UNAM - FES Acatlán - Maestría en Urbanismo </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='background-color' value='#008250' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='4030' id='12' type-v2='text' w='98574' x='713' y='94962'>
            <formatted-text>
              <run fontalignment='1' fontcolor='#191919' fontname='Arial' fontsize='6'>Fuente: INEGI - Portal de Datos Abiertos CDMX - Apimetro - VFTModel - Elaboración Propia 2025-2027</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5f6f8' />
            </zone-style>
          </zone>
          <zone h='82619' id='90' is-fixed='true' type-v2='layout-basic' w='12121' x='87166' y='12343'>
            <zone h='51133' id='20' param='vert' type-v2='layout-flow' w='12121' x='87166' y='12343'>
              <zone fixed-size='32' h='4030' id='22' is-fixed='true' param='horz' type-v2='layout-flow' w='12121' x='87166' y='12343' />
              <zone fixed-size='190' forceUpdate='true' h='24937' id='49' is-fixed='true' type-v2='text' w='12121' x='87166' y='16373'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#000000'>Explicación</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run fontalignment='1' fontcolor='#000000' fontsize='8'>------------------------</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>Valor normalizado de cada dimensión en los tres escenarios (0 a 1; 1 = óptimo). Las líneas marcan los umbrales de banda:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'><![CDATA[< 0.25 Crítico   0.25–0.50 Débil    0.50–0.75 Aceptable    ]]></run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>≥ 0.75 Idóneo.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='12343' id='92' type-v2='text' w='12121' x='87166' y='41310'>
                <formatted-text>
                  <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='8'>Hallazgo: solo Fluidez cambia de banda; el Anillo Metro alcanza Idóneo (0.822) y el Anillo MB queda en Aceptable (0.748).</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone h='31486' id='91' param='vert' type-v2='layout-flow' w='12121' x='87166' y='63476'>
              <zone fixed-size='155' forceUpdate='true' h='20529' id='52' is-fixed='true' type-v2='text' w='12121' x='87166' y='63476'>
