                <zone forceUpdate='true' h='34761' id='65' type-v2='text' w='12389' x='86898' y='23174'>
                  <formatted-text>
                    <run fontcolor='#000000' fontsize='10'>Valor normalizado de cada dimensión en los tres escenarios (0 a 1; 1 = óptimo). </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>Las líneas marcan los umbrales de banda:</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>* &lt; 0.25 Crítico   </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>* 0.25–0.50 Débil </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>* 0.50–0.75 Aceptable    </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>* ≥ 0.75 Idóneo.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
