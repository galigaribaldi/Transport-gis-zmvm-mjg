    <worksheet name='Tiempo Promedio de Viaje'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='10'><![CDATA[Tiempo promedio de viaje en la red de transporte de la ZMVM: <[federated.1h1armx06v1a7g10rpscj1fa2obm].[sum:T_minutos (wdc_t_escalar.csv):qk]> min vs. referencia ideal CDMX de 85 min. ]]></run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='10'><![CDATA[Una diferencia de ~<[federated.1h1armx06v1a7g10rpscj1fa2obm].[usr:Calculation_4932189854777344:qk]> min indica ineficiencia estructural que los transportes anillares buscan reducir.]]></run>
            <run>Æ&#10;</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='VFT Model' name='federated.1h1armx06v1a7g10rpscj1fa2obm' />
          </datasources>
          <datasource-dependencies datasource='federated.1h1armx06v1a7g10rpscj1fa2obm'>
            <column caption='Diferencia vs Ref (min)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_4932189854777344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([T_minutos (wdc_t_escalar.csv)]) - SUM([referencia_cdmx (wdc_t_escalar.csv)])' />
