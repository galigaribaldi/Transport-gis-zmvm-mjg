            <column-instance column='[betweenness_centrality]' derivation='Sum' name='[sum:betweenness_centrality:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0t7bsmm1eo8ne31a2z4rx1j3ng8s].[none:nombre:nk]'>
            <groupfilter count='20' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
