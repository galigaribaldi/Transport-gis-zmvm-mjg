            <column-instance column='[anio]' derivation='None' name='[none:anio:qk]' pivot='key' type='quantitative' />
            <column-instance column='[nombre_estacion]' derivation='None' name='[none:nombre_estacion:nk]' pivot='key' type='nominal' />
            <column-instance column='[num_comercial]' derivation='None' name='[none:num_comercial:nk]' pivot='key' type='nominal' />
            <column caption='Línea' datatype='string' name='[num_comercial]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;1&quot;' value='Línea 1: Observatorio — Pantitlán' />
                <alias key='&quot;2&quot;' value='Línea 2: Cuatro Caminos — Tasqueña' />
                <alias key='&quot;3&quot;' value='Línea 3: Indios Verdes — Universidad' />
                <alias key='&quot;4&quot;' value='Línea 4: Martín Carrera — Santa Anita' />
                <alias key='&quot;5&quot;' value='Línea 5: Politécnico — Pantitlán' />
                <alias key='&quot;6&quot;' value='Línea 6: El Rosario — Martín Carrera' />
                <alias key='&quot;7&quot;' value='Línea 7: El Rosario — Barranca del Muerto' />
                <alias key='&quot;8&quot;' value='Línea 8: Garibaldi — Constitución de 1917' />
                <alias key='&quot;9&quot;' value='Línea 9: Tacubaya — Pantitlán' />
                <alias key='&quot;A&quot;' value='Línea A: La Paz — Pantitlán' />
                <alias key='&quot;B&quot;' value='Línea B: Ciudad Azteca — Buenavista' />
                <alias key='&quot;L12&quot;' value='Línea 12: Mixcoac — Tláhuac' />
              </aliases>
            </column>
            <column-instance column='[afluencia]' derivation='Sum' name='[sum:afluencia:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0wd8lb114dajru19as24b0h5ivhj].[none:anio:qk]' included-values='in-range'>
            <min>2010</min>
            <max>2025</max>
